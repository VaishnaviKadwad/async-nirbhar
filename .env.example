# NIRBHAR — Environment Configuration Template
# Copy to .env and fill in local values. Never commit the real .env file.

# --- App ---
APP_ENV=development
APP_PORT=8000
DECISION_SUPPORT_ONLY_NOTICE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# --- Local SQLite database paths ---
NIRBHAR_DB_PATH=./data/evidence.sqlite3
NIRBHAR_AUDIT_DB_PATH=./data/audit.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nirbhar

# --- Vector store (SOP retrieval) ---
VECTOR_DB_BACKEND=faiss
VECTOR_DB_PATH=./data/vector_store
# VECTOR_DB_BACKEND=pgvector

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Local LLM (Ollama) ---
LLM_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Cold model load can take 30s+; startup warm-up handles it. See docs/DECISIONS.md
OLLAMA_TIMEOUT_SECONDS=30
# Set LLM_ENABLED=true only when OLLAMA_HOST points to a reachable model service.

# --- GPU ---
USE_GPU=false
# Set true only if a CUDA-capable GPU is confirmed available on the venue machine.

# --- Correlation / Rules ---
CORRELATION_THRESHOLD=0.70
CORRELATION_TIME_WINDOW_MINUTES=15

# --- Policy Packs ---
DEFAULT_POLICY_PACK=campus-safety-v1
ENABLE_FACTORY_PACK=false
# Set true only once the Campus pack is fully stable — see DECISIONS.md ADR-005
